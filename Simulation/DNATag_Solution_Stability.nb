Cell["\<\
Produces reactions in srxn[[reaction index],{x1,x2},{x3},k] format \
(\"structured reaction system\"):\
\>", "Text",
 CellChangeTimes->{{3.4682659085152397`*^9, 3.4682659425148363`*^9}, {
  3.468266373918969*^9, 
  3.468266381137883*^9}},ExpressionUUID->"7045a66c-8e99-4ee4-9997-\
50f0685332ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rxnsysToSrxnsys", "[", "rsys_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", "=", "1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"rsys", "/.", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rxn", "[", 
       RowBox[{"rs_", ",", "ps_", ",", "k_"}], "]"}], "\[RuleDelayed]", 
      "\[IndentingNewLine]", 
      RowBox[{"srxn", "[", 
       RowBox[{
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Unevaluated", "[", "rs", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Plus", "\[Rule]", "Seq"}], ",", 
            RowBox[{
             RowBox[{"c_Integer", "*", "s_"}], "\[RuleDelayed]", 
             RowBox[{"Seq", "@@", 
              RowBox[{"Table", "[", 
               RowBox[{"s", ",", 
                RowBox[{"{", "c", "}"}]}], "]"}]}]}]}], " ", "}"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Unevaluated", "[", "ps", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Plus", "\[Rule]", "Seq"}], ",", 
            RowBox[{
             RowBox[{"c_Integer", "*", "s_"}], "\[RuleDelayed]", 
             RowBox[{"Seq", "@@", 
              RowBox[{"Table", "[", 
               RowBox[{"s", ",", 
                RowBox[{"{", "c", "}"}]}], "]"}]}]}]}], " ", "}"}]}], "}"}], 
        ",", "\[IndentingNewLine]", "k"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.466719261540553*^9, 3.4667193292507133`*^9}, {
  3.466719402073004*^9, 3.466719426715269*^9}, {3.466720470119182*^9, 
  3.46672047063669*^9}, {3.466720825411582*^9, 3.466720886048728*^9}, {
  3.466720919606926*^9, 3.466720921646422*^9}, {3.466721266130591*^9, 
  3.4667214106046753`*^9}, {3.466733106831985*^9, 3.4667331511289673`*^9}, {
  3.466803320958659*^9, 3.4668033517280693`*^9}, {3.466803393266218*^9, 
  3.46680339619905*^9}, {3.4682645874002657`*^9, 3.468264587746196*^9}, {
  3.468264623275104*^9, 3.468264674943089*^9}, {3.468265538994667*^9, 
  3.468265566880356*^9}, {3.4682657885790663`*^9, 3.46826581895049*^9}, {

Cell["Compute \[Gamma] as discussed in the text:", "Text",
 CellChangeTimes->{{3.471013965544978*^9, 
  3.471013976103146*^9}},ExpressionUUID->"eb50a235-27fd-481c-897f-\
911d8569fc3b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeGamma", "[", "rsys_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["qmax", 
    RowBox[{"-", "1"}]], 
   RowBox[{"(", 
    RowBox[{"qmax", "-", 
     RowBox[{"computeSigma", "[", "rsys", "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.4682664437898397`*^9, 3.468266484281448*^9}},

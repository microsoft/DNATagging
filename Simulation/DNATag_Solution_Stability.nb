Cell[BoxData[
 RowBox[{
  RowBox[{"dnarxn", "[", 
   RowBox[{"i_", ",", 
    RowBox[{"{", "r1_", "}"}], ",", 
    RowBox[{"{", "ps___", "}"}], ",", "k_", ",", "\[Gamma]_"}], "]"}], ":=", 

Cell[CellGroupData[{

Cell["Code for modifying reaction system", "Subsection",
 CellChangeTimes->{{3.469243124613838*^9, 
  3.469243134692336*^9}},ExpressionUUID->"f36f9fa8-9f6f-432f-8b3f-\
91070bde7e3d"],

Cell["\<\
Adds waste product w[i] to reaction i.  This is useful for monitoring the \
total flow through reactions.\
\>", "Text",
 CellChangeTimes->{{3.469243195319902*^9, 3.4692432059730577`*^9}, {
  3.47101441627877*^9, 
  3.4710144337986183`*^9}},ExpressionUUID->"15198652-c6e5-4816-a7ad-\
9b32da0293b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"addWasteProducts", "[", 
   RowBox[{"rsys_", ",", "w_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", "=", "1"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"rsys", "/.", "  ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rxn", "[", 
       RowBox[{"rs_", ",", "ps_", ",", "k_"}], "]"}], "\[RuleDelayed]", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pse", "=", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"Plus", "[", 
             RowBox[{"ps", ",", 
              RowBox[{"w", "[", 
               RowBox[{"i", "++"}], "]"}]}], "]"}], ",", 
            RowBox[{"1", "\[Rule]", "0"}], ",", "1"}], "]"}]}], "}"}], ",", 
        RowBox[{"rxn", "[", 
         RowBox[{"rs", ",", "pse", ",", "k"}], "]"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4692430656020308`*^9, 3.469243081882278*^9}, {
  3.469243163408369*^9, 3.469243183196226*^9}, {3.469243275899234*^9, 

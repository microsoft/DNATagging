Cell[BoxData[
 RowBox[{
  RowBox[{"simulateRxnsysWithSchedule", "[", 
   RowBox[{"rxnsys_", ",", "schedule_", ",", "xs_List"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "schedule", "]"}]}], ",", "rsys", ",", 
      "lastsol", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rsys", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"rxnsys", ",", " ", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"conc", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"schedule", "\[LeftDoubleBracket]", 
              RowBox[{"1", ",", 
               RowBox[{"1", "+", 
                RowBox[{
                "#2", "\[LeftDoubleBracket]", "1", 
                 "\[RightDoubleBracket]"}]}]}], "\[RightDoubleBracket]"}]}], 
            "]"}], "&"}], ",", "xs"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"lastsol", "=", 
      RowBox[{"SimulateRxnsys", "[", 
       RowBox[{"rsys", ",", 
        RowBox[{"schedule", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol", "=", "lastsol"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"rsys", "=", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"rsysForRestart", "[", 
           RowBox[{"rsys", ",", "lastsol", ",", 
            RowBox[{"schedule", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{"i", "-", "1"}], ",", "1"}], 
             "\[RightDoubleBracket]"}]}], "]"}], "/.", "\[IndentingNewLine]", 
          
          RowBox[{"MapIndexed", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"conc", "[", 
               RowBox[{"#1", ",", "s_"}], "]"}], "\[RuleDelayed]", 
              "\[IndentingNewLine]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"s", "+", 
                    RowBox[{"schedule", "\[LeftDoubleBracket]", 
                    RowBox[{"i", ",", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}]}], 
                    "\[RightDoubleBracket]"}]}], "<", "0"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{"Message", "[", 
                   RowBox[{
                    RowBox[{
                    "simulateRxnsysWithSchedule", "::", "undershoot"}], ",", 
                    "i", ",", 
                    RowBox[{"schedule", "\[LeftDoubleBracket]", 
                    RowBox[{"i", ",", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}]}], 
                    "\[RightDoubleBracket]"}]}], "]"}]}], "]"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"conc", "[", 
                 RowBox[{"#1", ",", 
                  RowBox[{"Max", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{"s", "+", 
                    RowBox[{"schedule", "\[LeftDoubleBracket]", 
                    RowBox[{"i", ",", 
                    RowBox[{"1", "+", 
                    RowBox[{
                    "#2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}]}], 
                    "\[RightDoubleBracket]"}]}]}], "]"}]}], "]"}]}], ")"}]}], 
             "&"}], ",", "\[IndentingNewLine]", "xs"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"lastsol", "=", 
         RowBox[{"SimulateRxnsys", "[", 
          RowBox[{"rsys", ",", 
           RowBox[{"schedule", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#1", "/.", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"s_", "\[Rule]", "f1_"}], ")"}], "\[RuleDelayed]", 
              RowBox[{"(", 
               RowBox[{"s", "\[Rule]", 
                RowBox[{"joinFunctions", "[", 
                 RowBox[{"f1", ",", 
                  RowBox[{"#2", "/.", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"_", "\[Rule]", "f2_"}], ")"}], "\[RuleDelayed]", 
                    "f2"}]}], ",", 
                  RowBox[{"Total", "[", 
                   RowBox[{"schedule", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{";;", 
                    RowBox[{"i", "-", "1"}]}], ",", "1"}], 
                    "\[RightDoubleBracket]"}], "]"}], ",", 
                  RowBox[{"Total", "[", 
                   RowBox[{"schedule", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{";;", "i"}], ",", "1"}], 
                    "\[RightDoubleBracket]"}], "]"}]}], "]"}]}], ")"}]}]}], 
            "&"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"sol", ",", "lastsol"}], "}"}]}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "sol"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.4684266555296383`*^9, 3.468426752994502*^9}, {

Cell["\<\
Main function to convert a formal CRN to the DNA implementation.  Note that \
the generateBufferingModules \[Rule] False option can be used when buffering \
modules are not wanted. \
\>", "Text",
 CellChangeTimes->{{3.471014196319229*^9, 
  3.4710142256799498`*^9}},ExpressionUUID->"65f8ae63-fd10-44dc-ab29-\
c3c663a9ca41"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "rxnsysToDnasys", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"generateBufferingModules", "\[Rule]", "True"}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.4693786836060133`*^9, 3.469378755929044*^9}, {
  3.469379188187153*^9, 3.469379189166761*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"ce34d1f9-9773-4a86-a312-2c24074bf560"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rxnsysToDnasys", "[", 
   RowBox[{"rsys_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Gamma]", "=", 
       RowBox[{"computeGamma", "[", "rsys", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Sigma]", "=", 
       RowBox[{"computeSigma", "[", "rsys", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Join", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"rxnsysToSrxnsys", "[", "rsys", "]"}], "/.", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"srxn", "[", 
           RowBox[{"i_", ",", "rs_", ",", "ps_", ",", "k_"}], "]"}], 
          "\[RuleDelayed]", 
          RowBox[{"dnarxn", "[", 
           RowBox[{"i", ",", "rs", ",", "ps", ",", "k", ",", "\[Gamma]"}], 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"conc", "[", 
           RowBox[{"s_", ",", "c_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"conc", "[", 
           RowBox[{"s", ",", 
            RowBox[{
             SuperscriptBox["\[Gamma]", 
              RowBox[{"-", "1"}]], "c"}]}], "]"}]}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"computeSigmaj", "[", 
             RowBox[{"#", ",", "rsys"}], "]"}], "<", "\[Sigma]"}], " ", "&&", 
           " ", 
           RowBox[{"OptionValue", "[", "generateBufferingModules", "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"dnabalrxn", "[", 
           RowBox[{"#", ",", "\[Gamma]", ",", "\[Sigma]", ",", 
            RowBox[{"computeSigmaj", "[", 
             RowBox[{"#", ",", "rsys"}], "]"}]}], "]"}], ",", 
          RowBox[{"Seq", "[", "]"}]}], "]"}], "&"}], "  ", 
       "\[IndentingNewLine]", "/@", "  ", 
       RowBox[{"SpeciesInRxnsys", "[", "rsys", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",

   3.468433845144533*^9}, {3.468433904495595*^9, 3.468433912194406*^9}, {
   3.4684339673012857`*^9, 3.468433967394178*^9}, {3.468434169262932*^9, 
   3.468434171264441*^9}, 3.468434229579741*^9, {3.468436165728587*^9, 
   3.468436250238064*^9}, {3.468862766163143*^9, 3.468862830417835*^9}, {

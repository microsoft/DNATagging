Cell[CellGroupData[{

Cell["Stability of DNA Bit 1 and Bit 0 in solution of 10mM MgCl2. ", \
"Subsubsection",
 CellChangeTimes->{{3.4687028147836723`*^9, 3.468702826009041*^9}, {
  3.935257517827701*^9, 3.935257520579844*^9}, {3.9353417804710083`*^9, 
  3.935341795477233*^9}},ExpressionUUID->"ebdb01b5-f2d3-4f98-a9cd-\
8e89fa0c0457"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x1", " ", "=", " ", "Bit1"}], ",", " ", 
    RowBox[{"x2", " ", "=", " ", "Bit0"}], ",", " ", 
    RowBox[{"x3", " ", "=", " ", "blocker"}], ",", " ", 
    RowBox[{"x4", " ", "=", " ", 
     RowBox[{"blocked", " ", "Bit1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"x5", " ", "=", " ", 
      RowBox[{"dissocated", " ", "Bit0"}]}], ";", " ", "\[IndentingNewLine]", 
     
     RowBox[{"Conc", " ", 
      RowBox[{"unit", ":", " ", "\[Micro]M"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "Initial", " ", "concentrations", " ", "of", " ", "Bit", " ", "1", " ", 
       "and", " ", "Bit", " ", "0"}], " ", "=", " ", 
      RowBox[{"4", " ", "\[Micro]M"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Blocker", " ", "strand"}], " ", "=", " ", 
      RowBox[{"'", 
       RowBox[{"CTCTCCTTATCAAACCACCAC", "'"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dG", " ", "of", " ", "Blocker", " ", "strand"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "13.99"}], " ", 
       RowBox[{"kcal", "/", "mol"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Hybridization", " ", "rate", " ", "constant", " ", 
       RowBox[{"(", "k_hyb", ")"}]}], " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "e6", " ", 
        RowBox[{"M", "^", 
         RowBox[{"-", "1"}]}], 
        RowBox[{"\[Bullet]s", "^", 
         RowBox[{"-", "1"}]}]}], " ", "=", " ", 
       RowBox[{"1", " ", 
        RowBox[{"\[Micro]M", "^", 
         RowBox[{"-", "1"}]}], 
        RowBox[{"\[Bullet]s", "^", 
         RowBox[{"-", "1"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Dissociation", " ", "rate", " ", "constant"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"k_hyb", "/", 
        RowBox[{"(", 
         RowBox[{"exp", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "dG"}], "/", 
            RowBox[{"(", 
             RowBox[{"T", "*", "R"}], ")"}]}], ")"}]}], ")"}]}], " ", "=", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"5.45", "e"}], "-", 
         RowBox[{"5", " ", 
          RowBox[{"M", "^", 
           RowBox[{"-", "1"}]}], 
          RowBox[{"\[Bullet]s", "^", 
           RowBox[{"-", "1"}]}]}]}], " ", "=", " ", 
        RowBox[{
         RowBox[{"5.45", "e"}], "-", 
         RowBox[{"11", " ", 
          RowBox[{"M", "^", 
           RowBox[{"-", "1"}]}], 
          RowBox[{"\[Bullet]s", "^", 
           RowBox[{"-", "1"}]}]}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Time", " ", "step"}], " ", "=", " ", 
      RowBox[{"1", " ", 
       RowBox[{"second", "."}]}]}]}]}], " ", "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"rsys", "=", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rxn", "[", 
       RowBox[{
        RowBox[{"x1", "+", "x3"}], ",", "x4", ",", "1"}], "]"}], ",", " ", 
      RowBox[{"(*", 
       RowBox[{"Bit1", " ", "+", " ", 
        RowBox[{"blocker", " ", "hybridization"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"reactant", ",", " ", "product", ",", " ", 
        RowBox[{"rate", " ", "constant"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rxn", "[", 
       RowBox[{"x2", ",", 
        RowBox[{"x5", " ", "+", " ", "x3"}], ",", "0.0000000000545"}], "]"}], 
      ",", 
      RowBox[{"(*", " ", 
       RowBox[{"Bit", " ", "0", " ", "dissociation"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"rxn", "[", 
       RowBox[{"x4", ",", " ", 
        RowBox[{"x1", "+", "x3"}], ",", " ", "0.0000000000545"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"rxn", "[", 

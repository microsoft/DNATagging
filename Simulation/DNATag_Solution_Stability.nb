Cell[BoxData[
 RowBox[{
  RowBox[{"dnabalrxn", "[", 
   RowBox[{"s_", ",", "\[Gamma]_", ",", "\[Sigma]_", ",", "\[Sigma]j_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j", "=", 
      RowBox[{"ToString", "[", "s", "]"}]}], "}"}], ",", 

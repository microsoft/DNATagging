Cell[TextData[{
 "This ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " notebook requires the CRNSimulator package.  It can be downloaded from: \
http://dna.caltech.edu/SupplementaryMaterial/DNA_for_CRNs/\n\nWe try to load \
it from the same directory as this notebook:"
}], "Text",

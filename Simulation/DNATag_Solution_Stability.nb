Cell["\<\
Computes the concentration and time scaling factors for the DNA system so \
that largest concentration cmax is maxconc (usually 10^-5), and max rate \
constant qmax is maxrateconst (usually 10^6):\
\>", "Text",
 CellChangeTimes->{{3.4683477553837137`*^9, 3.4683477642351027`*^9}, {
  3.468347815187289*^9, 3.468347952606078*^9}, {3.468348037470215*^9, 
  3.46834804076059*^9}, {3.46834815434439*^9, 3.468348184733625*^9}, {
  3.468348302785129*^9, 3.468348314086027*^9}, {3.469390709028771*^9, 
  3.469390709425508*^9}},ExpressionUUID->"28a1c889-2f4c-4d25-9b0a-\
821735086f37"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeConcAndTimeScaling", "[", 
   RowBox[{"maxconc_", ",", "maxrateconst_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"maxconc", "/", "cmax"}], ",", " ", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"maxconc", "/", "cmax"}], ")"}], 
      RowBox[{"-", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"maxrateconst", "/", "qmax"}], ")"}], 
      RowBox[{"-", "1"}]]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.468347353930036*^9, 3.468347376922575*^9}, {
  3.4683477958012457`*^9, 3.4683478113105164`*^9}, {3.468347894269884*^9, 

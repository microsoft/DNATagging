Cell[BoxData[
 RowBox[{
  RowBox[{"dnarxn", "[", 
   RowBox[{"i_", ",", 
    RowBox[{"{", 
     RowBox[{"r1_", ",", "r2_"}], "}"}], ",", 
    RowBox[{"{", "ps__", "}"}], ",", "k_", ",", "\[Gamma]_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Seq", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"revrxn", "[", 
     RowBox[{
      RowBox[{"r1", "+", 
       RowBox[{"gateL", "[", "i", "]"}]}], ",", 
      RowBox[{
       RowBox[{"gateH", "[", "i", "]"}], "+", 
       RowBox[{"strandB", "[", "i", "]"}]}], ",", 
      RowBox[{
       SuperscriptBox["\[Gamma]", 
        RowBox[{"-", "1"}]], "k"}], " ", ",", "qmax"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{"r2", "+", 
       RowBox[{"gateH", "[", "i", "]"}]}], ",", 
      RowBox[{"strandO", "[", "i", "]"}], ",", "qmax"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rxn", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"strandO", "[", "i", "]"}], "+", 
       RowBox[{"gateT", "[", "i", "]"}]}], ",", 
      RowBox[{"Plus", "[", "ps", "]"}], ",", "qmax"}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"conc", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gateL", "[", "i", "]"}], ",", 
        RowBox[{"strandB", "[", "i", "]"}], ",", 
        RowBox[{"gateT", "[", "i", "]"}]}], "}"}], ",", "cmax"}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.466718787837919*^9, 3.46671887592767*^9}, {
   3.466718919676318*^9, 3.4667190137321444`*^9}, {3.466719053194322*^9, 
   3.466719063594983*^9}, {3.4667190944048357`*^9, 3.466719135434703*^9}, {
   3.466719182398572*^9, 3.466719218942*^9}, {3.466720865628283*^9, 

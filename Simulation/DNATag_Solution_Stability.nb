   3.4690444953053417`*^9, 3.469044630158238*^9}, {3.469050419695273*^9, 
   3.4690504375972633`*^9}, {3.469050527993095*^9, 3.4690505297197933`*^9}, 
   3.469056671028235*^9, {3.470085615698497*^9, 3.470085615729067*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"df8beeb8-eccf-4c57-83ce-db49a1ce7ee9"],

Cell["\<\
Since some species are buffered, we may not be able to instantaneously \
decrease concentration because this may result in going negative.  We do 1/3 \
of the distance, then 1/3 of the remaining distance, etc (here 3 is the \
stepfactor).  Rescaled so that after all iterations we cover the whole \
distance.\
\>", "Text",
 CellChangeTimes->{{3.469043993052598*^9, 3.469044019599833*^9}, {
  3.469058772399272*^9, 
  3.469058840161098*^9}},ExpressionUUID->"515a7538-8ed9-48b6-a9b7-\
af97b7dcf188"],

Cell[BoxData[
 RowBox[{
  RowBox[{"steppizeSchedule", "[", 
   RowBox[{"schedule_", ",", "iterations_", ",", 
    RowBox[{"stepfactor_", ":", "3"}], ",", 
    RowBox[{"stepduration_", ":", "0.01"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sum", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"stepfactor", "-", "1"}], ")"}], "/", 
          RowBox[{"(", "stepfactor", ")"}]}], ")"}], "^", 
        RowBox[{"(", "iterations", ")"}]}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Map", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Seq", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"Rest", "[", "#", "]"}], "]"}], "*", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"stepfactor", "-", "1"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}]}], 
             RowBox[{
              RowBox[{
               RowBox[{"(", "stepfactor", ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"-", "i"}], ")"}]}], " ", "/", " ", "sum"}]}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "\[Equal]", "iterations"}], ",", 
              RowBox[{"First", "[", "#", "]"}], ",", "stepduration"}], 
             "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "iterations"}], "}"}]}], "]"}]}], 
       "&"}], ",", "\[IndentingNewLine]", "schedule"}], "]"}]}], 
   "]"}]}]], "Input",

Cell["\<\
For formal functions of one argument, whose definitions are valid starting at \
0 ending at end1 and end2.  Make new function which uses the second one when \
first one ends:\
\>", "Text",
 CellChangeTimes->{{3.4684307894702997`*^9, 3.4684308087692842`*^9}, {
   3.4684308924759912`*^9, 3.468430895540433*^9}, {3.468431178333012*^9, 
   3.468431180052823*^9}, {3.468431244389275*^9, 3.4684312450290422`*^9}, {
   3.468431341614399*^9, 3.468431344484817*^9}, {3.468432901304203*^9, 
   3.4684329120810537`*^9}, {3.468433658398958*^9, 3.468433659667742*^9}, 
   3.46843600670105*^9, {3.4684360404715776`*^9, 3.4684361391831408`*^9}, {
   3.4710143015546503`*^9, 3.471014315273918*^9}, 
   3.471014349832326*^9},ExpressionUUID->"f945fd37-b9df-4b87-9992-\
f8ab41373f56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"joinFunctions", "[", 
   RowBox[{"f1_", ",", "f2_", ",", "end1_", ",", "end2_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Function", "[", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"Which", "@@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0", "\[LessEqual]", "#", "<", "end1"}], ",", " ", 
       RowBox[{"f1", "[", "#", "]"}], ",", 
       RowBox[{"end1", "\[LessEqual]", "#", "<", 
        RowBox[{"end1", "+", "end2"}]}], ",", " ", 
       RowBox[{"f2", "[", 
        RowBox[{"#", "-", "end1"}], "]"}]}], "}"}]}], "]"}], "]"}]}]], "Input",\

 CellChangeTimes->CompressedData["

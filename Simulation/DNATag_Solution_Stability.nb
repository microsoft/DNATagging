Cell["\<\
Find the lower-bound on qmax as discussed in the text. Note that the \
generateBufferingModules \[Rule] False option can be used when buffering \
modules are not wanted.\
\>", "Text",
 CellChangeTimes->{{3.4710139857111597`*^9, 
  3.4710140579031*^9}},ExpressionUUID->"8a174c8f-9b66-4d4d-84ab-df1b1f455001"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "computeQmaxLowerBound", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"generateBufferingModules", "\[Rule]", "True"}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.46938624159839*^9, 3.469386257401639*^9}, {
  3.4693960776986923`*^9, 3.469396110843193*^9}, {3.469396189594985*^9, 
  3.46939619173807*^9}, {3.469396336751161*^9, 3.469396337597087*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"c1a76b92-d15f-4f96-b489-78dd9b477f47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeQmaxLowerBound", "[", 
   RowBox[{"rsys_", ",", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Sigma]", "=", 
       RowBox[{"computeSigma", "[", "rsys", "]"}]}], ",", 
      RowBox[{"srsys", "=", 
       RowBox[{"rxnsysToSrxnsys", "[", "rsys", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Max", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Cases", "[", 
       RowBox[{"srsys", ",", 
        RowBox[{
         RowBox[{"srxn", "[", 
          RowBox[{"_", ",", 
           RowBox[{"{", "_", "}"}], ",", "_", ",", "k_"}], "]"}], 
         "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"k", "/", "cmax"}], "+", "\[Sigma]"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Cases", "[", 
       RowBox[{"srsys", ",", 
        RowBox[{
         RowBox[{"srxn", "[", 
          RowBox[{"_", ",", 
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}], ",", "_", ",", "k_"}], "]"}], 
         "\[RuleDelayed]", 
         RowBox[{"k", "+", "\[Sigma]"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "generateBufferingModules", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "\[Sigma]"}], "-", 
            RowBox[{"computeSigmaj", "[", 
             RowBox[{"#", ",", "rsys"}], "]"}]}], ")"}], "&"}], "  ", "/@", 
         "  ", 
         RowBox[{"SpeciesInRxnsys", "[", "rsys", "]"}]}], ",", 
        "\[IndentingNewLine]", "0"}], "]"}]}], "\[IndentingNewLine]", "]"}]}],
    "]"}]}]], "Input",
 CellChangeTimes->{{3.468938109229052*^9, 3.4689381384358377`*^9}, {
   3.468938208222786*^9, 3.468938211099874*^9}, {3.468938255745904*^9, 
   3.468938304590993*^9}, {3.4689383452868433`*^9, 3.468938358047537*^9}, {
